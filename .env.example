# Copie para .env e preencha os valores reais. Nunca versione o .env.

# Supabase/PostgreSQL. Use a URL com pooler para a aplicação e a conexão direta
# para migrations. Nunca use a service role no navegador.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@DB_HOST:5432/postgres"

# Segredo usado para assinar o cookie de sessão (JWT).
# Gere com: openssl rand -base64 32
AUTH_SECRET=""

# URL pública da aplicação (links de redefinição de senha e notificações)
APP_URL="http://localhost:3000"

# BlackCat Payments (somente backend). Obtenha a chave no painel administrativo.
BLACKCAT_API_KEY=""
BLACKCAT_API_BASE_URL="https://api.blackcathub.com/api"

# Supabase Storage (somente backend; necessário quando anexos forem habilitados)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# SMTP (opcional — necessário para envio real de e-mail de recuperação de senha)
# Sem SMTP configurado, o link de redefinição é registrado no log do servidor (apenas dev).
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
